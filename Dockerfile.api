FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg is required by clip generation; libgl/glib support OpenCV imports.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY api/requirements.txt /tmp/api-requirements.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/api-requirements.txt \
    && pip install ffmpeg-python opencv-python-headless numpy greenlet

# ── ML dependencies (lean CPU build) ─────────────────────────────────────────
# CPU-only torch keeps the image several GB smaller than the CUDA build.
# paddle/paddleocr (jersey OCR) intentionally excluded — not wired into the
# pipeline yet. Roboflow `inference` runs the ball model locally (no API).
# inference MUST be pinned: unpinned, pip's resolver backtracked to 0.28.1,
# which predates RF-DETR support and broke the ball model
# (KeyError ('object-detection', 'rfdetr-small')).
# build-essential/cmake are needed transiently: zxing-cpp (pulled in by
# inference) ships no arm64 wheel, so pip compiles it from source on Apple
# Silicon. Install and purge in the same layer to keep the image lean.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake \
    && pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install ultralytics==8.3.55 "transformers>=4.40.0" "Pillow>=10.0.0" "inference==1.3.3" \
    && apt-get purge -y build-essential cmake \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Copy code after dependencies.
COPY api /app/api
COPY ml /app/ml

# Render start commands (CF-170). chmod here rather than trusting the mode in
# git: the repo is worked on from Windows, where the executable bit does not
# survive, and a non-executable start script fails the deploy with a "not
# found" that points at the wrong thing.
COPY scripts /app/scripts
RUN chmod +x /app/scripts/*.sh

# Run as a non-root user so Celery doesn't warn about superuser privileges.
# /models seeds the model_cache volume's ownership: a named volume inherits
# the image directory's owner on first creation, and appuser must be able to
# write downloaded model weights there (CF-40).
RUN useradd -m -u 1000 -s /bin/bash appuser \
    && mkdir -p /models \
    && chown -R appuser:appuser /app /models
USER appuser

ENV PYTHONPATH=/app
WORKDIR /app/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
