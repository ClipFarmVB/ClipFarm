FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg is required by clip generation; libgl/glib support OpenCV imports.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY api/requirements.txt /tmp/api-requirements.txt
# numpy and opencv are PINNED, and pinned to the same versions as
# ml/requirements.txt and ml/modal_pose.py. This is not tidiness: pipeline code
# runs in this process AND in the Modal image, and rally dicts cross that
# boundary as a pickle. A numpy-2 pickle names `numpy._core`, which a numpy-1.x
# image cannot import, so a version split here fails at *deserialization* on the
# far side — which the caller can only see as "Modal failed", one warning line.
# Bump these files together or not at all: this one, ml/requirements.txt and
# ml/modal_pose.py — and, for numpy, api/requirements-dev.txt as well, which
# pins it (CF-276) so the tests run against the major the pipeline ships. The
# pin-consistency test requires the numpy pin in all four (the dev file is
# optional only for packages it has no business pinning, like opencv), so a
# split and a removal both fail it; the gate script's own test asserts the dev
# pin stays a plain `==` line besides.
#
# opencv has a fourth site, absent from that list: ml/modal_app.py (CF-278) —
# fifth file named in this block, but the dev file above is deliberately not an
# opencv source, so four is the count that matters. numpy is the exception
# there and only there — that image's inference==1.3.3 requires numpy>=2.0,<2.4,
# so it cannot carry 1.26.4 and is a deliberate numpy-2 island. Closing that
# split means migrating the repo to numpy 2, decided on #323 and carried by
# CF-363 (#443); a separate test asserts the island stays on 2.x rather than
# acquiring an unresolvable 1.x pin in the meantime.
RUN pip install --upgrade pip \
    && pip install -r /tmp/api-requirements.txt \
    && pip install ffmpeg-python opencv-python-headless==4.10.0.84 numpy==1.26.4 greenlet

# ── NO ML dependencies in this image (CF-164) ────────────────────────────
# Every model now runs on Modal: ball tracking on `clipfarm-ball-tracking`
# (CF-11), pose on `clipfarm-pose` (CF-164). With both offloaded, torch,
# torchvision, ultralytics, transformers and Roboflow `inference` all leave —
# which is what lets the Render worker drop from `standard` (2 GB) to `starter`
# (512 MB). What remains is ffmpeg (clip cutting), opencv + numpy (frame and
# signal work) and boto3.
#
# The pipeline still *imports* those packages, always lazily and always behind
# a guard: without them the local fallbacks degrade rather than crash (pose
# refinement keeps the ball-trajectory labels; CLIP scoring drops its visual
# component; local-CPU ball tracking is gone). Install ml/requirements.txt
# outside this image to get those paths back for development.
#
# Consequence worth stating plainly: with no torch here, a Modal outage costs
# label quality and the local-CPU fallbacks, not the run. Restoring a
# CPU-capable image means re-adding torch AND sizing the worker back up — do
# not do one without the other.
#
# paddle/paddleocr (jersey OCR) remains excluded — not wired into the pipeline.

# Copy code after dependencies.
COPY api /app/api
COPY ml /app/ml

# Render start commands (CF-170). chmod here rather than trusting the mode in
# git: the repo is worked on from Windows, where the executable bit does not
# survive, and a non-executable start script fails the deploy with a "not
# found" that points at the wrong thing.
COPY scripts /app/scripts
RUN chmod +x /app/scripts/*.sh

# Run as a non-root user so Celery doesn't warn about superuser privileges.
# No /models directory any more: nothing in this image downloads model weights
# (CF-164), so the cache it seeded has nothing left to hold.
RUN useradd -m -u 1000 -s /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONPATH=/app
WORKDIR /app/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
