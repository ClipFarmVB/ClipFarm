FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg is required by clip generation; libgl/glib support OpenCV imports.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY api/requirements.txt /tmp/api-requirements.txt
RUN pip install --upgrade pip \
    && pip install -r /tmp/api-requirements.txt \
    && pip install ffmpeg-python opencv-python-headless numpy greenlet

# ── ML dependencies (lean CPU build) ─────────────────────────────────────────
# CPU-only torch keeps the image several GB smaller than the CUDA build.
# paddle/paddleocr (jersey OCR) intentionally excluded — not wired into the
# pipeline yet. Roboflow `inference` runs the ball model locally (no API).
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install ultralytics==8.3.55 "transformers>=4.40.0" "Pillow>=10.0.0" inference

# Copy code after dependencies.
COPY api /app/api
COPY ml /app/ml

# Run as a non-root user so Celery doesn't warn about superuser privileges.
RUN useradd -m -u 1000 -s /bin/bash appuser \
    && chown -R appuser:appuser /app
USER appuser

ENV PYTHONPATH=/app
WORKDIR /app/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
