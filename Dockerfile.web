FROM node:20-alpine

WORKDIR /app

# Install root workspace deps used by the web workspace.
COPY package.json package-lock.json ./
COPY web/package.json ./web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN npm ci

# Copy app source. The shared api client is source, not a build artifact, so
# the web dev server compiles it in place along with the app (CF-314).
COPY web ./web
COPY packages ./packages

EXPOSE 3000

CMD ["npm", "--workspace=web", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
