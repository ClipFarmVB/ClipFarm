# Copy to mobile/.env (gitignored) before `npm run start --workspace=mobile`.
#
# This file is for local development only. An EAS build never sees `mobile/.env`
# — it is gitignored, and EAS uploads the project by .gitignore — so the same
# three variables have to be registered with `eas env:create`. See the EAS
# section of mobile/README.md.
#
# EXPO_PUBLIC_* is inlined into the bundle at build time, exactly like the web
# app's NEXT_PUBLIC_* — so nothing secret goes in here. The Supabase anon key is
# public by design; the service key is not and never belongs in the app.

# Where the ClipFarm API lives. The iOS Simulator shares your machine's
# localhost; the Android emulator does not — there localhost is the emulator,
# so use http://10.0.2.2:8000 or `adb reverse tcp:8000 tcp:8000`. A physical
# device needs the LAN address Expo prints.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Same project the web app signs into, so an existing account works.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public identity: profiles, feed, follows (CF-107). Off by default — the API
# half is gated separately by SOCIAL_ENABLED in api/app/config.py, and with that
# off the routes 404, so turning this on alone yields a surface that cannot load.
EXPO_PUBLIC_SOCIAL_ENABLED=false
