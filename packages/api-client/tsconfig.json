{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for *types* only — `fetch`, `Response`, `RequestInit`,
    // `Headers`, `FormData`, `File`. Those exist on React Native too (Expo's
    // tsconfig.base pulls in the same lib), and nothing in this package touches
    // `window`, `document` or any other DOM API. Adding a runtime DOM
    // dependency is what the package must not do; borrowing the type names for
    // web-standard globals is fine.
    "lib": ["ES2022", "DOM"],
    // Empty on purpose, and the thing that makes `npm run typecheck` mean
    // anything. With `types` unset, tsc auto-includes every `@types/*` package
    // it finds walking up to the nearest `node_modules/@types` — which, after
    // the install CI runs, is the repo ROOT, holding `node`, `react` and
    // `react-dom` hoisted out of `web`. The package would then typecheck green
    // against ambient `process`, `Buffer` and `setImmediate` that no React
    // Native consumer has, and the gate would pass on exactly the coupling it
    // exists to catch. `lib` above is the deliberate list; this says "and
    // nothing else, however the installer happens to hoist".
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
