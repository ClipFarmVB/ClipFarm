{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here because it is where TypeScript declares the web-standard
    // globals the package calls at runtime — `fetch`, `URLSearchParams`,
    // `FormData` — and the types it borrows (`Response`, `RequestInit`, `File`).
    // React Native implements only part of that lib, so the lib is not the
    // contract: `src/platformSurface.test.ts` pins the exact names, methods
    // included, and fails on anything else. Nothing here touches `window`,
    // `document` or `localStorage`.
    "lib": ["ES2022", "DOM"],
    // Empty on purpose, and the thing that makes `npm run typecheck` mean
    // anything. With `types` unset, tsc auto-includes every `@types/*` package
    // it finds walking up to the nearest `node_modules/@types` — which, after
    // the install CI runs, is the repo ROOT, holding `node`, `react` and
    // `react-dom` hoisted out of `web`. The package would then typecheck green
    // against ambient `process`, `Buffer` and `setImmediate` that no React
    // Native consumer has, and the gate would pass on exactly the coupling it
    // exists to catch. `lib` above is the deliberate list; this says "and
    // nothing else, however the installer happens to hoist".
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
