#!/bin/sh
# ClipFarm pre-commit hook
# Runs the same checks GitHub Actions CI runs, so failures are caught locally.
# Not a byte-for-byte mirror: CI uses two Python environments (ruff/mypy in a
# dependency-light one, then api/tests after installing the app deps), while the
# hook has one. See the mypy note below.
#
# Install for your clone — this is a step you own; nothing does it for you:
#   git config core.hooksPath .hooks
#
# Requirements: ruff, mypy, pytest, and npm on PATH. For the full api/tests step:
#   pip install -r api/requirements-dev.txt     # app deps + pytest + fakeredis
# Install that and every step runs. With only `pip install ruff mypy pytest`,
# the api/tests step skips (loudly) rather than erroring — the app-importing
# tests can't collect without the app's own deps.
#
# One consequence of the single environment: with the api deps installed, the
# mypy step below sees stubs CI's dependency-light run does not, so it can report
# findings CI never will. Those are not regressions — CI installs those deps only
# after it has already run mypy, on purpose.
# For npm: it should already be available.

set -e

# ── Interpreter ───────────────────────────────────────────────────────────────
# Resolve once; every Python step below uses $PY.
#
# Not `command -v python`: on Windows, `python` and `python3` are Microsoft Store
# alias stubs in %LOCALAPPDATA%\Microsoft\WindowsApps, that directory precedes a
# real install on PATH, and the stubs are present and executable. They pass every
# existence check and then refuse to run, printing an install advert and exiting
# 49. So the probe has to actually execute something and see it work.
#
# Order matters: `python` first keeps Linux, macOS and CI on exactly the
# interpreter they use today. `py` is the Windows launcher, which reaches the
# real install the stubs shadow. Note the steps stay `-m` module invocations —
# on Windows `Scripts\` is typically off PATH too, so bare `ruff`/`mypy`
# executables are not an alternative.
# Cleared first: PY is a plausible name to have exported for other reasons, and
# an inherited value would sail past the guard below and be used as if it had
# been probed.
PY=""
for _candidate in python py python3; do
  if "$_candidate" -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
    PY="$_candidate"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "pre-commit: no working Python interpreter found." >&2
  echo "  Tried: python, py, python3 — each either missing or not executable." >&2
  echo "  On Windows, 'python' is often a Microsoft Store stub that exits without" >&2
  echo "  running; install Python and make sure 'py' works, or disable the alias" >&2
  echo "  under Settings > Apps > Advanced app settings > App execution aliases." >&2
  exit 1
fi

echo "pre-commit: running CI checks... (python: $PY)"

# ── API: ruff lint ────────────────────────────────────────────────────────────
printf "  ruff check api/ ... "
"$PY" -m ruff check api/
echo "ok"

# ── API: mypy type-check ──────────────────────────────────────────────────────
printf "  mypy api/app ...     "
"$PY" -m mypy api/app --ignore-missing-imports
echo "ok"

# ── ML eval: ruff + mypy ──────────────────────────────────────────────────────
printf "  ruff check ml/eval . "
"$PY" -m ruff check ml/eval
echo "ok"
printf "  mypy ml/eval ...     "
"$PY" -m mypy ml/eval --ignore-missing-imports --explicit-package-bases --namespace-packages
echo "ok"

# ── ML: unit tests (eval metrics + dead-time) ─────────────────────────────────
printf "  pytest ml/tests ...  "
if ! _pytest_out=$("$PY" -m pytest ml/tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_pytest_out"
  exit 1
fi
echo "ok"

# ── API: unit tests ───────────────────────────────────────────────────────────
# Runs from api/ (in a subshell, so later steps stay at the repo root) because
# the tests do `from app... import ...`.
#
# Unlike ml/tests these need the application's own dependencies, plus the
# test-only ones. The probe is `fakeredis`, not an app runtime dep: it is the one
# importorskip target that lives only in requirements-dev.txt, so importing it
# proves the whole dev set is present. (pytest is pinned there too, but it is
# already assumed on PATH for the ml/tests step above, so it can't discriminate a
# dev install from a plain one.) Probing a runtime dep (pydantic-settings, etc.)
# would pass after a plain `pip install -r requirements.txt` and then let
# test_worker_safety.py's CF-65a Redis-lock test silently importorskip — the
# exact passing-without-executing failure the requirements-dev install exists to
# end. Treat a set without fakeredis as "not runnable here" and leave it to CI
# rather than blocking the commit on a setup step nobody was told to do.
printf "  pytest api/tests ... "
if ! "$PY" -c "import fakeredis" >/dev/null 2>&1; then
  echo "skipped (pip install -r api/requirements-dev.txt to run these locally)"
  _api_tests_skipped=1
elif ! _api_pytest_out=$(cd api && "$PY" -m pytest tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_api_pytest_out"
  exit 1
else
  echo "ok"
fi

# ── Web: ESLint ───────────────────────────────────────────────────────────────
printf "  eslint (web) ...     "
npm run lint --workspace=web --silent
echo "ok"

# ── Web: TypeScript ───────────────────────────────────────────────────────────
printf "  tsc (web) ...        "
npm run typecheck --workspace=web --silent
echo "ok"

# ── Web: unit tests (vitest) ──────────────────────────────────────────────────
printf "  vitest (web) ...     "
if ! _vitest_out=$(npm run test --workspace=web --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

if [ -n "$_api_tests_skipped" ]; then
  echo "pre-commit: all checks passed (api/tests skipped — pip install -r api/requirements-dev.txt to run them)."
else
  echo "pre-commit: all checks passed."
fi
