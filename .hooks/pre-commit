#!/bin/sh
# ClipFarm pre-commit hook
# Runs the same checks GitHub Actions CI runs, so failures are caught locally.
# Not a byte-for-byte mirror: CI uses two Python environments (ruff/mypy in a
# dependency-light one, then api/tests after installing the app deps), while the
# hook has one. See the mypy note below.
#
# Install for your clone:
#   git config core.hooksPath .hooks
#
# Requirements: a working Python (see "Locate a working Python" below), with
# ruff, mypy and pytest installed *into it*, plus npm on PATH. Set
# CLIPFARM_PYTHON to skip the search and use a specific one. The steps invoke
# the tools as modules (`-m ruff`) rather than as bare `ruff`/`mypy` commands:
# on Windows the Scripts/ directory holding those shims is routinely absent from
# PATH even when the interpreter itself is fine.
#
#   pip install -r requirements-tooling.txt     # ruff + mypy + pytest, pinned
#   pip install -r api/requirements-dev.txt     # app deps + the test-only pins
#
# Use the tooling file rather than `pip install ruff mypy pytest`: those are the
# versions CI runs (CF-92), so a finding here is a finding there. Unpinned, a
# fresh install can disagree with CI in either direction — ruff 0.16.0 widened
# its default rule set and reddened a branch nobody had touched.
#
# Install both and every step runs. With only the tooling file, the api/tests
# step skips (loudly) rather than erroring — the app-importing tests can't
# collect without the app's own deps, and the dev-set gate below says so.
#
# One consequence of the single environment: with the api deps installed, the
# mypy step below sees stubs CI's dependency-light run does not, so it can report
# findings CI never will. Those are not regressions — CI installs those deps only
# after it has already run mypy, on purpose.
# For npm: it should already be available.

set -e

echo "pre-commit: running CI checks..."

# ── Locate a working Python ───────────────────────────────────────────────────
# `python` is not a safe assumption. On a standard Windows setup the Microsoft
# Store ships `python` and `python3` alias stubs in
# %LOCALAPPDATA%\Microsoft\WindowsApps, and that directory precedes a real
# install on PATH — so both names resolve, and both fail with "Python was not
# found..." and exit 49, killing the hook on its first step.
#
# So candidates are probed by *running* one, not by `command -v`: the stub is
# present and executable, it just refuses to be an interpreter. `py` (the Windows
# launcher) comes second because it exists nowhere else; `python3` last, for the
# Linux/macOS installs that ship no bare `python`.
#
# The probe is `-m ruff`, not `-c ""`, because "is an interpreter" is not the
# question the steps below ask. The loop stops at the first candidate that
# passes, so probing only for an interpreter lets a bare, toolless `python`
# early on PATH beat a fully equipped `py` two places later — and every commit
# then dies on step one with `No module named ruff`, naming the module but not
# which of the three interpreters is missing it. Not a corner case: the remedy
# for the stub problem this hook exists to fix is "install a real Python", which
# puts exactly such a `python` at the front of PATH.
#
# ruff alone stands in for all three tools, since requirements-tooling.txt
# installs ruff, mypy and pytest together. A hand-installed partial set still
# slips through, which is what the "using ..." line below is for: it makes a
# later `No module named mypy` say which interpreter to install into.
PY=
_toolless=
if [ -n "$CLIPFARM_PYTHON" ]; then
  # An override is honoured on the interpreter check alone. If you named one,
  # the hook should use it and let the steps report their own missing modules,
  # rather than quietly falling back to something you did not choose.
  if ! "$CLIPFARM_PYTHON" -c "" >/dev/null 2>&1; then
    echo "pre-commit: CLIPFARM_PYTHON is set to '$CLIPFARM_PYTHON', which did not run." >&2
    echo "  Point it at a Python that works, or unset it to probe python, py," >&2
    echo "  python3 in that order." >&2
    exit 1
  fi
  PY=$CLIPFARM_PYTHON
else
  for _candidate in python py python3; do
    "$_candidate" -c "" >/dev/null 2>&1 || continue
    if "$_candidate" -m ruff --version >/dev/null 2>&1; then
      PY=$_candidate
      break
    fi
    _toolless="$_toolless $_candidate"
  done
fi
if [ -z "$PY" ] && [ -n "$_toolless" ]; then
  # Its own message rather than "no working Python": these ran fine, so sending
  # someone to install Python points them at the one thing that is not broken.
  echo "pre-commit: found Python, but no tooling in it — tried$_toolless." >&2
  echo "  They run; none has ruff, so the checks below cannot start." >&2
  echo "  Install into the one you want, then commit again:" >&2
  echo "    <python> -m pip install -r requirements-tooling.txt" >&2
  echo "    <python> -m pip install -r api/requirements-dev.txt" >&2
  echo "  Or point the hook at one already equipped: CLIPFARM_PYTHON=py" >&2
  exit 1
fi
if [ -z "$PY" ]; then
  echo "pre-commit: no working Python found — tried python, py, python3." >&2
  echo "  Each was either missing or refused to run (on Windows, the Microsoft" >&2
  echo "  Store 'python' stub does the latter). Install Python, put a real" >&2
  echo "  interpreter ahead of the stub on PATH, or set CLIPFARM_PYTHON to one," >&2
  echo "  and commit again." >&2
  exit 1
fi
# Named, not merely chosen: with three candidates in play, a `No module named
# ...` from any step below is unactionable until you know which one raised it.
echo "pre-commit: using $PY"

# ── API: ruff lint ────────────────────────────────────────────────────────────
printf "  ruff check api/ ... "
"$PY" -m ruff check api/
echo "ok"

# ── API: mypy type-check ──────────────────────────────────────────────────────
printf "  mypy api/app ...     "
"$PY" -m mypy api/app --ignore-missing-imports
echo "ok"

# ── ML: ruff over all of ml/, mypy over ml/eval ───────────────────────────────
# ruff lints the working tree, not the staged set: an untracked scratch .py
# anywhere under ml/ blocks every commit until it is cleaned up or ignored.
printf "  ruff check ml/ ...   "
"$PY" -m ruff check ml/
echo "ok"
printf "  mypy ml/eval ...     "
"$PY" -m mypy ml/eval --ignore-missing-imports --explicit-package-bases --namespace-packages
echo "ok"

# ── ML: unit tests (eval metrics + dead-time) ─────────────────────────────────
printf "  pytest ml/tests ...  "
if ! _pytest_out=$("$PY" -m pytest ml/tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_pytest_out"
  exit 1
fi
echo "ok"

# ── API: unit tests ───────────────────────────────────────────────────────────
# Runs from api/ (in a subshell, so later steps stay at the repo root) because
# the tests do `from app... import ...`.
#
# Unlike ml/tests these need the application's own dependencies, plus the
# test-only ones, so the step is gated on the dev set being installed. Probing a
# runtime dep (pydantic-settings, etc.) would pass after a plain
# `pip install -r requirements.txt` and then let the guarded tests silently
# importorskip themselves — the exact passing-without-executing failure the
# requirements-dev install exists to end. A set without it is "not runnable
# here": leave it to CI rather than blocking the commit on a setup step nobody
# was told to do.
#
# The gate reads the `name==version` pins reachable from requirements-dev.txt
# (following its `-r` include) and checks each is *present* — not importing one
# chosen package, because a chosen package is what broke this. The probe used
# to be `fakeredis`, which CF-184 removed from that file when the lock moved to
# Postgres — after which the probe could never succeed, this step skipped on
# every correct dev install, and the hook still exited 0 saying all checks
# passed. It had been doing that silently ever since. Swapping in another name
# would reinstate the same failure one rename later, and neither candidate
# discriminates anyway: PyYAML arrives with unrelated tooling (conan depends on
# it) and numpy is on half the machines in the world.
#
# Presence, deliberately not version equality, for every pin: an absent
# dependency kills collection, which is the case this gate exists to decline,
# while gating on versions made any drift in the same virtualenv — a tool
# bumping a patch release, numpy resolved elsewhere by other work — skip
# api/tests while the hook exited 0, the silent-green shape this gate replaced
# on a wider trigger. Version consistency across the files that matter is
# test_pipeline_deps_are_pinned_to_one_version_everywhere's job, and CI runs
# the suite in an environment built exactly from requirements-dev.txt.
#
# The check lives in api/scripts/check_dev_set.py rather than inline here, so
# the `ruff check api/` step above lints it and api/tests tests it — this
# block's predecessor rotted for the lack of both. Its exact scope (extras,
# whitespace, what is skipped) is documented in the script.
#
# It does not fail the commit, it declines to run the step and says why: an
# incomplete dev set is "not runnable here", not a reason to block someone who
# was never told to install it.
#
# The reason arrives on stdout and only stdout is captured, so a genuine
# breakage in the script — a traceback, a moved file — lands on the terminal
# instead of being printed as if it were the reason, and the fallback message
# below blames the check rather than the dev set. An earlier version captured
# stderr and claimed the opposite in this very comment.
# It is also the hook's slowest step by some margin — ~12s against ~2s for tsc
# and well under 1s for everything else, because it imports fastapi, sqlalchemy
# and celery at collection. That is worth an explicit way out: without one the
# only lever is `--no-verify`, which skips every check in this file rather than
# the one that costs the time. Loud on purpose, and never the default.
#
# Locating the probe is its own problem, and getting it wrong is invisible.
# `$_dev_set_probe` is relative, so the `"$PY" "$_dev_set_probe"` below resolves
# it against the CWD, which is the tree being committed in. That is right, and
# it is what this does — but only if it is allowed to fail honestly when the
# file is not there.
#
# Why a tree can lack it: this file can be SHARED across checkouts, and then it
# runs against a tree it did not come from. Two ways in, not one:
#
#   An absolute `core.hooksPath` — every worktree runs that one checkout's hook.
#
#   A copy in `.git/hooks/pre-commit`. `hooks` lives in the COMMON dir, so a
#   linked worktree resolves it to the main repo's `.git/hooks` rather than to
#   anything of its own, and gets the same shared file.
#
# Set relative instead, as `git config core.hooksPath .hooks` at the top of this
# file and in README.md prescribe, and git resolves it against each working
# tree's own root — so a worktree runs its own hook, matched to its own `api/`,
# and hook and probe can never disagree. That one setting fixes both causes,
# because `core.hooksPath` takes precedence over `.git/hooks`.
#
# That is a misconfiguration rather than a case to work around, and the
# tempting workaround is worse than the bug. Falling back to the copy beside
# this hook would run a FOREIGN checkout's probe: check_dev_set.py resolves its
# requirements file from its own __file__, so it would validate the hook
# checkout's dependency set and then hand a pass to a pytest run over this
# tree's tests. Where the two trees have diverged — which is precisely when the
# fallback would fire — the probe says yes, collection dies on an import, and
# the FAIL branch below `exit 1`s. That turns a gate which promises never to
# block a commit into one that blocks it for a dependency the committer was
# never asked to install.
#
# So: this tree's probe, or an honest skip.
#
# And this tree's *interpreter*, which is the other half of the same point:
# `$PY` rather than a bare `python`, because the probe has to answer for the one
# the pytest step below will actually use. A probe run under a different
# interpreter reports on a different environment than the one under test — the
# same class of mismatch as the foreign-checkout case above, reached through
# PATH instead of through a shared hook.
_dev_set_probe=api/scripts/check_dev_set.py

printf "  pytest api/tests ... "
if [ -n "$CLIPFARM_SKIP_API_TESTS" ]; then
  echo "skipped — CLIPFARM_SKIP_API_TESTS is set"
  _api_tests_skipped="unset CLIPFARM_SKIP_API_TESTS to run them"
elif [ ! -f "$_dev_set_probe" ]; then
  # Its own branch because no install fixes it: pointing at pip would send
  # someone down a road that cannot end. Self-contained on purpose — the
  # summary at the bottom is the last thing a reader sees, so the remedy has to
  # survive being read on its own, without the line above it.
  echo "skipped — $_dev_set_probe is not in this working tree; if other branches have it, this hook is shared across checkouts (an absolute core.hooksPath, or a copy in .git/hooks): git config core.hooksPath .hooks"
  _api_tests_skipped="this tree has no $_dev_set_probe; if other branches do, this hook is shared across checkouts — run: git config core.hooksPath .hooks"
elif ! _api_dev_reason=$("$PY" "$_dev_set_probe"); then
  # The probe declines for three different reasons — an incomplete dev set, a
  # requirements file it cannot find, and its own crash — and only the first is
  # fixed by installing anything. `$_api_dev_reason` already distinguishes them
  # on the line above; carry the same distinction into the summary rather than
  # prescribing pip for all three.
  case "$_api_dev_reason" in
    missing:*)
      echo "skipped — $_api_dev_reason; pip install -r api/requirements-dev.txt"
      _api_tests_skipped="pip install -r api/requirements-dev.txt to run them" ;;
    "")
      echo "skipped — the dev-set check itself failed, see the traceback above"
      _api_tests_skipped="$_dev_set_probe failed; see its traceback above" ;;
    *)
      echo "skipped — $_api_dev_reason"
      _api_tests_skipped="$_api_dev_reason" ;;
  esac
elif ! _api_pytest_out=$(cd api && "$PY" -m pytest tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_api_pytest_out"
  exit 1
else
  echo "ok"
fi

# ── Web: ESLint ───────────────────────────────────────────────────────────────
printf "  eslint (web) ...     "
npm run lint --workspace=web --silent
echo "ok"

# ── Web: TypeScript ───────────────────────────────────────────────────────────
printf "  tsc (web) ...        "
npm run typecheck --workspace=web --silent
echo "ok"

# ── Shared api client: TypeScript ─────────────────────────────────────────────
# Its own tsconfig, not web's: the package has to compile for a React Native
# consumer too, and web's lib/paths would hide a coupling that breaks there.
printf "  tsc (api-client) ... "
npm run typecheck --workspace=packages/api-client --silent
echo "ok"

# ── Web: unit tests (vitest) ──────────────────────────────────────────────────
printf "  vitest (web) ...     "
if ! _vitest_out=$(npm run test --workspace=web --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

# ── Shared api client: unit tests (vitest) ────────────────────────────────────
# The suites that moved out of web/src/lib with their modules (CF-314).
printf "  vitest (api-client)  "
if ! _vitest_out=$(npm run test --workspace=packages/api-client --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

if [ -n "$_api_tests_skipped" ]; then
  # The remedy comes from whichever branch skipped, because they do not share
  # one. Hard-coding the dev-set install here told someone whose install was
  # fine to reinstall it, which is how the missing-probe bug stayed invisible.
  echo "pre-commit: all checks passed (api/tests skipped — ${_api_tests_skipped})."
else
  echo "pre-commit: all checks passed."
fi
