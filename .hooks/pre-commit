#!/bin/sh
# ClipFarm pre-commit hook
# Runs the same checks GitHub Actions CI runs, so failures are caught locally.
# Not a byte-for-byte mirror: CI uses two Python environments (ruff/mypy in a
# dependency-light one, then api/tests after installing the app deps), while the
# hook has one. See the mypy note below.
#
# Install for your clone:
#   git config core.hooksPath .hooks
#
# Requirements: a working Python (see "Locate a working Python" below), with
# ruff, mypy and pytest installed *into it*, plus npm on PATH. The steps invoke
# the tools as modules (`-m ruff`) rather than as bare `ruff`/`mypy` commands:
# on Windows the Scripts/ directory holding those shims is routinely absent from
# PATH even when the interpreter itself is fine. For the full api/tests step:
#   pip install -r api/requirements-dev.txt     # app deps + the test-only pins
# Install that and every step runs. With only `pip install ruff mypy pytest`,
# the api/tests step skips (loudly) rather than erroring — the app-importing
# tests can't collect without the app's own deps.
#
# One consequence of the single environment: with the api deps installed, the
# mypy step below sees stubs CI's dependency-light run does not, so it can report
# findings CI never will. Those are not regressions — CI installs those deps only
# after it has already run mypy, on purpose.
# For npm: it should already be available.

set -e

echo "pre-commit: running CI checks..."

# ── Locate a working Python ───────────────────────────────────────────────────
# `python` is not a safe assumption. On a standard Windows setup the Microsoft
# Store ships `python` and `python3` alias stubs in
# %LOCALAPPDATA%\Microsoft\WindowsApps, and that directory precedes a real
# install on PATH — so both names resolve, and both fail with "Python was not
# found..." and exit 49, killing the hook on its first step.
#
# So candidates are probed by *running* one, not by `command -v`: the stub is
# present and executable, it just refuses to be an interpreter. `py` (the Windows
# launcher) comes second because it exists nowhere else; `python3` last, for the
# Linux/macOS installs that ship no bare `python`.
PY=
for _candidate in python py python3; do
  if "$_candidate" -c "" >/dev/null 2>&1; then
    PY=$_candidate
    break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: no working Python found — tried python, py, python3." >&2
  echo "  Each was either missing or refused to run (on Windows, the Microsoft" >&2
  echo "  Store 'python' stub does the latter). Install Python, or put a real" >&2
  echo "  interpreter ahead of the stub on PATH, and commit again." >&2
  exit 1
fi

# ── API: ruff lint ────────────────────────────────────────────────────────────
printf "  ruff check api/ ... "
"$PY" -m ruff check api/
echo "ok"

# ── API: mypy type-check ──────────────────────────────────────────────────────
printf "  mypy api/app ...     "
"$PY" -m mypy api/app --ignore-missing-imports
echo "ok"

# ── ML: ruff over all of ml/, mypy over ml/eval ───────────────────────────────
# ruff lints the working tree, not the staged set: an untracked scratch .py
# anywhere under ml/ blocks every commit until it is cleaned up or ignored.
printf "  ruff check ml/ ...   "
"$PY" -m ruff check ml/
echo "ok"
printf "  mypy ml/eval ...     "
"$PY" -m mypy ml/eval --ignore-missing-imports --explicit-package-bases --namespace-packages
echo "ok"

# ── ML: unit tests (eval metrics + dead-time) ─────────────────────────────────
printf "  pytest ml/tests ...  "
if ! _pytest_out=$("$PY" -m pytest ml/tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_pytest_out"
  exit 1
fi
echo "ok"

# ── API: unit tests ───────────────────────────────────────────────────────────
# Runs from api/ (in a subshell, so later steps stay at the repo root) because
# the tests do `from app... import ...`.
#
# Unlike ml/tests these need the application's own dependencies, plus the
# test-only ones, so the step is gated on the dev set being installed. Probing a
# runtime dep (pydantic-settings, etc.) would pass after a plain
# `pip install -r requirements.txt` and then let the guarded tests silently
# importorskip themselves — the exact passing-without-executing failure the
# requirements-dev install exists to end. A set without it is "not runnable
# here": leave it to CI rather than blocking the commit on a setup step nobody
# was told to do.
#
# The gate reads the `name==version` pins reachable from requirements-dev.txt
# (following its `-r` include) and checks each is *present* — not importing one
# chosen package, because a chosen package is what broke this. The probe used
# to be `fakeredis`, which CF-184 removed from that file when the lock moved to
# Postgres — after which the probe could never succeed, this step skipped on
# every correct dev install, and the hook still exited 0 saying all checks
# passed. It had been doing that silently ever since. Swapping in another name
# would reinstate the same failure one rename later, and neither candidate
# discriminates anyway: PyYAML arrives with unrelated tooling (conan depends on
# it) and numpy is on half the machines in the world.
#
# Presence, deliberately not version equality, for every pin: an absent
# dependency kills collection, which is the case this gate exists to decline,
# while gating on versions made any drift in the same virtualenv — a tool
# bumping a patch release, numpy resolved elsewhere by other work — skip
# api/tests while the hook exited 0, the silent-green shape this gate replaced
# on a wider trigger. Version consistency across the files that matter is
# test_pipeline_deps_are_pinned_to_one_version_everywhere's job, and CI runs
# the suite in an environment built exactly from requirements-dev.txt.
#
# The check lives in api/scripts/check_dev_set.py rather than inline here, so
# the `ruff check api/` step above lints it and api/tests tests it — this
# block's predecessor rotted for the lack of both. Its exact scope (extras,
# whitespace, what is skipped) is documented in the script.
#
# It does not fail the commit, it declines to run the step and says why: an
# incomplete dev set is "not runnable here", not a reason to block someone who
# was never told to install it.
#
# The reason arrives on stdout and only stdout is captured, so a genuine
# breakage in the script — a traceback, a moved file — lands on the terminal
# instead of being printed as if it were the reason, and the fallback message
# below blames the check rather than the dev set. An earlier version captured
# stderr and claimed the opposite in this very comment.
# It is also the hook's slowest step by some margin — ~12s against ~2s for tsc
# and well under 1s for everything else, because it imports fastapi, sqlalchemy
# and celery at collection. That is worth an explicit way out: without one the
# only lever is `--no-verify`, which skips every check in this file rather than
# the one that costs the time. Loud on purpose, and never the default.
printf "  pytest api/tests ... "
if [ -n "$CLIPFARM_SKIP_API_TESTS" ]; then
  echo "skipped — CLIPFARM_SKIP_API_TESTS is set"
  _api_tests_skipped=1
elif ! _api_dev_reason=$("$PY" api/scripts/check_dev_set.py); then
  echo "skipped — ${_api_dev_reason:-the dev-set check itself failed, see the traceback above}; pip install -r api/requirements-dev.txt"
  _api_tests_skipped=1
elif ! _api_pytest_out=$(cd api && "$PY" -m pytest tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_api_pytest_out"
  exit 1
else
  echo "ok"
fi

# ── Web: ESLint ───────────────────────────────────────────────────────────────
printf "  eslint (web) ...     "
npm run lint --workspace=web --silent
echo "ok"

# ── Web: TypeScript ───────────────────────────────────────────────────────────
printf "  tsc (web) ...        "
npm run typecheck --workspace=web --silent
echo "ok"

# ── Web: unit tests (vitest) ──────────────────────────────────────────────────
printf "  vitest (web) ...     "
if ! _vitest_out=$(npm run test --workspace=web --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

if [ -n "$_api_tests_skipped" ]; then
  echo "pre-commit: all checks passed (api/tests skipped — pip install -r api/requirements-dev.txt to run them)."
else
  echo "pre-commit: all checks passed."
fi
