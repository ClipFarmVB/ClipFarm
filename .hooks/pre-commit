#!/bin/sh
# ClipFarm pre-commit hook
# Runs the same checks GitHub Actions CI runs, so failures are caught locally.
# Not a byte-for-byte mirror: CI uses two Python environments (ruff/mypy in a
# dependency-light one, then api/tests after installing the app deps), while the
# hook has one. See the mypy note below.
#
# Install for your clone:
#   git config core.hooksPath .hooks
#
# Requirements: ruff, mypy, pytest, and npm on PATH. For the full api/tests step:
#   pip install -r api/requirements-dev.txt     # app deps + the test-only pins
# Install that and every step runs. With only `pip install ruff mypy pytest`,
# the api/tests step skips (loudly) rather than erroring — the app-importing
# tests can't collect without the app's own deps.
#
# One consequence of the single environment: with the api deps installed, the
# mypy step below sees stubs CI's dependency-light run does not, so it can report
# findings CI never will. Those are not regressions — CI installs those deps only
# after it has already run mypy, on purpose.
# For npm: it should already be available.

set -e

echo "pre-commit: running CI checks..."

# ── API: ruff lint ────────────────────────────────────────────────────────────
printf "  ruff check api/ ... "
python -m ruff check api/
echo "ok"

# ── API: mypy type-check ──────────────────────────────────────────────────────
printf "  mypy api/app ...     "
python -m mypy api/app --ignore-missing-imports
echo "ok"

# ── ML eval: ruff + mypy ──────────────────────────────────────────────────────
printf "  ruff check ml/eval . "
python -m ruff check ml/eval
echo "ok"
printf "  mypy ml/eval ...     "
python -m mypy ml/eval --ignore-missing-imports --explicit-package-bases --namespace-packages
echo "ok"

# ── ML: unit tests (eval metrics + dead-time) ─────────────────────────────────
printf "  pytest ml/tests ...  "
if ! _pytest_out=$(python -m pytest ml/tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_pytest_out"
  exit 1
fi
echo "ok"

# ── API: unit tests ───────────────────────────────────────────────────────────
# Runs from api/ (in a subshell, so later steps stay at the repo root) because
# the tests do `from app... import ...`.
#
# Unlike ml/tests these need the application's own dependencies, plus the
# test-only ones, so the step is gated on the dev set being installed. Probing a
# runtime dep (pydantic-settings, etc.) would pass after a plain
# `pip install -r requirements.txt` and then let the guarded tests silently
# importorskip themselves — the exact passing-without-executing failure the
# requirements-dev install exists to end. A set without it is "not runnable
# here": leave it to CI rather than blocking the commit on a setup step nobody
# was told to do.
#
# The gate reads requirements-dev.txt instead of importing one chosen package,
# because a chosen package is what broke this. The probe used to be `fakeredis`,
# which CF-184 removed from that file when the lock moved to Postgres — after
# which the probe could never succeed, this step skipped on every correct dev
# install, and the hook still exited 0 saying all checks passed. It had been
# doing that silently ever since.
#
# Swapping in another name would reinstate the same failure one rename later,
# and neither candidate discriminates anyway: PyYAML arrives with unrelated
# tooling (conan depends on it) and numpy is on half the machines in the world,
# so importing either proves nothing about a dev install.
#
# Scope, stated precisely rather than as "every pin": it checks the plain
# `name==version` lines. Extras (`foo[bar]==1.0`), range constraints and
# environment markers are skipped, so adding one of those weakens the gate
# silently — put a plain pin in this file, or extend the pattern.
#
# It does not fail the commit, it declines to run the step and says why: an
# incomplete dev set is "not runnable here", not a reason to block someone who
# was never told to install it. stderr is deliberately not redirected, so a
# genuine breakage in this block is visible instead of reading as a skip.
_api_dev_set=1
_api_dev_reason=$(python - 2>&1 >/dev/null <<'PY'
import pathlib, re, sys
from importlib.metadata import PackageNotFoundError, version

# The `name==pin` lines of requirements-dev.txt — its own test-only deps, which
# is precisely what a plain `-r requirements.txt` install does not give you.
# `-r requirements.txt` and comments are skipped by the pattern.
pins = {}
for raw in pathlib.Path("api/requirements-dev.txt").read_text().splitlines():
    m = re.fullmatch(r"([A-Za-z0-9_.\-]+)==([A-Za-z0-9_.\-]+)", raw.split("#", 1)[0].strip())
    if m:
        pins[m.group(1)] = m.group(2)

def installed(name):
    try:
        return version(name)
    except PackageNotFoundError:
        return None

# No pins parsed means the file moved or changed shape — report the set as
# absent rather than running the suite against who knows what.
if not pins:
    print("no pins parsed from api/requirements-dev.txt", file=sys.stderr)
    sys.exit(1)

missing = [
    f"{n}=={v}" + ("" if installed(n) is None else f" (have {installed(n)})")
    for n, v in sorted(pins.items())
    if installed(n) != v
]
if missing:
    # Name them: "run the install you already ran" is a useless thing to be told.
    print("missing or mismatched: " + ", ".join(missing), file=sys.stderr)
    sys.exit(1)
PY
) || _api_dev_set=0

printf "  pytest api/tests ... "
if [ "$_api_dev_set" -eq 0 ]; then
  echo "skipped — ${_api_dev_reason:-dev set unavailable}; pip install -r api/requirements-dev.txt"
  _api_tests_skipped=1
elif ! _api_pytest_out=$(cd api && python -m pytest tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_api_pytest_out"
  exit 1
else
  echo "ok"
fi

# ── Web: ESLint ───────────────────────────────────────────────────────────────
printf "  eslint (web) ...     "
npm run lint --workspace=web --silent
echo "ok"

# ── Web: TypeScript ───────────────────────────────────────────────────────────
printf "  tsc (web) ...        "
npm run typecheck --workspace=web --silent
echo "ok"

# ── Web: unit tests (vitest) ──────────────────────────────────────────────────
printf "  vitest (web) ...     "
if ! _vitest_out=$(npm run test --workspace=web --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

if [ -n "$_api_tests_skipped" ]; then
  echo "pre-commit: all checks passed (api/tests skipped — pip install -r api/requirements-dev.txt to run them)."
else
  echo "pre-commit: all checks passed."
fi
