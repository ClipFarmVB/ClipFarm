#!/bin/sh
# ClipFarm pre-commit hook
# Mirrors exactly what GitHub Actions CI runs so failures are caught locally.
#
# Install for your clone:
#   git config core.hooksPath .hooks
#
# Requirements: ruff, mypy, pytest, and npm must be on PATH.
# In the api/ virtualenv: pip install ruff mypy pytest
# The api/tests step additionally needs the app's own deps and the test-only
# ones (pip install -r api/requirements-dev.txt); without them it is skipped.
# For npm: it should already be available.

set -e

echo "pre-commit: running CI checks..."

# ── API: ruff lint ────────────────────────────────────────────────────────────
printf "  ruff check api/ ... "
python -m ruff check api/
echo "ok"

# ── API: mypy type-check ──────────────────────────────────────────────────────
printf "  mypy api/app ...     "
python -m mypy api/app --ignore-missing-imports
echo "ok"

# ── ML eval: ruff + mypy ──────────────────────────────────────────────────────
printf "  ruff check ml/eval . "
python -m ruff check ml/eval
echo "ok"
printf "  mypy ml/eval ...     "
python -m mypy ml/eval --ignore-missing-imports --explicit-package-bases --namespace-packages
echo "ok"

# ── ML: unit tests (eval metrics + dead-time) ─────────────────────────────────
printf "  pytest ml/tests ...  "
if ! _pytest_out=$(python -m pytest ml/tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_pytest_out"
  exit 1
fi
echo "ok"

# ── API: unit tests ───────────────────────────────────────────────────────────
# Runs from api/ (in a subshell, so later steps stay at the repo root) because
# the tests do `from app... import ...`.
#
# Unlike ml/tests these need the application's own dependencies: the
# `pytest.importorskip` guards only cover the optional test doubles, so without
# pydantic-settings the app-importing tests error at collection rather than
# skipping. The header only asks for `pip install ruff mypy pytest`, so treat a
# dependency-free environment as "not runnable here" and leave it to CI instead
# of blocking the commit on a setup step nobody was told to do.
printf "  pytest api/tests ... "
if ! python -c "import pydantic_settings" >/dev/null 2>&1; then
  echo "skipped (pip install -r api/requirements-dev.txt to run these locally)"
elif ! _api_pytest_out=$(cd api && python -m pytest tests/ -q --no-header 2>&1); then
  echo "FAIL"
  echo "$_api_pytest_out"
  exit 1
else
  echo "ok"
fi

# ── Web: ESLint ───────────────────────────────────────────────────────────────
printf "  eslint (web) ...     "
npm run lint --workspace=web --silent
echo "ok"

# ── Web: TypeScript ───────────────────────────────────────────────────────────
printf "  tsc (web) ...        "
npm run typecheck --workspace=web --silent
echo "ok"

# ── Web: unit tests (vitest) ──────────────────────────────────────────────────
printf "  vitest (web) ...     "
if ! _vitest_out=$(npm run test --workspace=web --silent 2>&1); then
  echo "FAIL"
  echo "$_vitest_out"
  exit 1
fi
echo "ok"

echo "pre-commit: all checks passed."
