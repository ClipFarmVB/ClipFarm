# ─────────────────────────────────────────────────────────────────────────────
# ClipFarm — Docker environment template
# Copy to .env.docker and fill in real values before running docker compose.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# Leave unset (defaults to "development") for the dev stack: everything below
# has a working local default, and that is the point.
#
# ENVIRONMENT=production turns on the required-settings check in
# api/app/config.py (CF-172) — api and worker then refuse to start when
# DATABASE_URL, the SUPABASE_* keys or the R2_* credentials are missing, naming
# the ones that are, rather than falling back to a localhost database. The VPS
# stack sets it for you (docker-compose.prod.yml), and so does render.yaml, so
# there is nothing to add here.
# ENVIRONMENT=development

# ── Local Postgres (used by the db container) ─────────────────────────────────
POSTGRES_DB=clipfarm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Database ──────────────────────────────────────────────────────────────────
# Option A (default): the local Postgres container. Local means local — the api
# migrates it on boot, so a branch carrying a new Alembic revision is applied
# here and nowhere else.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/clipfarm
# Option B: the shared Supabase pooler. Deliberate opt-in — general dev and
# testing use the shared DB on purpose (it's what makes the shared dev-account
# login useful: everyone uploads/sees the same games and clips), but the api
# will NOT migrate it on boot (CF-189). Landing a new migration there is a
# separate, one-time step (see README § Local Development).
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/postgres
# The worker's per-game lock (CF-184) is a session-scoped Postgres advisory
# lock, and takes its own connection from DATABASE_URL. Both options above are
# session-mode, so this stays unset; set it only if DATABASE_URL becomes a
# TRANSACTION-mode pooler (Supabase port 6543), which cannot hold such a lock.
# LOCK_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Any long random string — used to sign JWTs
JWT_SECRET=change-me-use-a-long-random-string

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>        # keep this secret — server only
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>     # safe to expose in the browser

# ── Cloudflare R2 (video + clip storage) ─────────────────────────────────────
# Found in: Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_PUBLIC_URL=https://<your-bucket>.r2.dev          # public URL for serving clips

# ── Web origins allowed to call the api (CORS) ───────────────────────────────
# The dev stack's default (http://localhost:3000,http://127.0.0.1:3000) is right
# for local work, so leave this alone there.
#
# The VPS stack REQUIRES it: docker-compose.prod.yml runs api and worker with
# ENVIRONMENT=production, and the guard in api/app/config.py treats the
# localhost default as "never set" — the api refuses to boot naming
# CORS_ORIGINS. That is deliberate: left on the default the api would boot
# clean, pass its health check, and CORS-block every request from the real
# site, with no server-side symptom at all.
#
# Since CF-235 the SHAPE of each entry is checked too, and the boot is refused
# for a value that is set but cannot work: a bare `*` (which with credentials on
# is a real cross-origin leak, not untidiness), and anything a browser can never
# send as an Origin — a trailing slash, backslash, path, query or fragment,
# upper case, `user:password@`, a wildcard host, a default or zero-padded port,
# a raw-unicode host, a percent-escape, whitespace, or an invisible/control
# character. Write bare origins: scheme://host[:port], nothing else.
# CORS_ORIGINS=https://your-site.example,https://www.your-site.example

# ── Roboflow (ball detection model) ──────────────────────────────────────────
# Found in: Roboflow dashboard → Settings → API Keys
ROBOFLOW_API_KEY=<roboflow-api-key>

# ── Modal (GPU inference — ball tracking + pose) ─────────────────────────
# Since CF-164 both models run on Modal and the container image ships no torch,
# so leaving these blank no longer means "slow local CPU" — it means pose never
# runs and clips keep their ball-trajectory labels. Deploy the two apps once:
#   modal deploy ml/modal_app.py && modal deploy ml/modal_pose.py
# Found in: modal.com → Settings → API Tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Fabricated detections (development only) ────────────────────────────
# With no ball pipeline, no Modal and no local pose runtime there is nothing to
# detect, and the worker fails the game rather than inventing clips. Set this to
# true ONLY to get placeholder clips for UI work — the worker persists whatever
# it produces, so anything written while this is on is made up. Never set it
# against a shared database. Deliberately separate from DEBUG, which is a
# general dev-fallbacks flag shared by the api and the worker.
#
# Setting this affects the DEV stack only: docker-compose.prod.yml pins it off
# for the worker, because api and worker read this same file on that box and a
# flag set to debug one of them must not let the other write invented rows.
# ALLOW_STUB_DETECTIONS=true

# ── Sentry error monitoring (optional — CF-89) ───────────────────────────────
# Leave DSNs blank to disable. Found in: Sentry → Project → Settings → Client Keys (DSN).
# api + worker share SENTRY_DSN; the web app needs the NEXT_PUBLIC_ copy.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.0
# Release identifier — set to the deployed commit SHA so events are attributed
# to a specific build (and matched to uploaded source maps). Blank locally.
# Setting SENTRY_RELEASE alone is enough: next.config.ts resolves the web app's
# release from it and re-exports it under the NEXT_PUBLIC_ name for the browser.
# In production the deploy config supplies it explicitly from Render's
# $RENDER_GIT_COMMIT (see render.yaml, added in CF-68).
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
# Source-map upload at web build time (CI/prod only) — without this, prod web
# stack traces point at minified bundles instead of real source lines:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Expose /debug/sentry on a PRODUCTION build, to verify Sentry end-to-end on a
# staging/preview deploy. Leave unset in real prod (absent = route 404s).
#
# It does nothing in this file: the compose stack runs `next dev`, which already
# serves the route. It only has an effect on a `next build`, and it's inlined at
# build time, so it belongs in the DEPLOY config of the environment that needs it
# — set it on the staging web service in render.yaml (CF-152), not here. Listed
# for discoverability only.
# NEXT_PUBLIC_ENABLE_DEBUG_ROUTES=true

# ── Social surface (CF-107) ───────────────────────────────────────────────────
# Public identity — profiles, handles, avatars — is behind a flag so the epic can
# land incrementally without exposing it in production. BOTH halves must be on:
# the api one gates whether /users/* is registered at all, the web one gates the
# pages, the sidebar profile row and the claim banner.
#
# NEXT_PUBLIC_SOCIAL_ENABLED is inlined at build time, so flipping it needs a
# rebuild of web, not a restart.
SOCIAL_ENABLED=true
NEXT_PUBLIC_SOCIAL_ENABLED=true
