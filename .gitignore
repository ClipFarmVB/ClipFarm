ml/eval/ball_caches/
# Generated by ml/eval/visualize_deadtime.py — ~1MB of inline SVG that would
# re-churn its whole diff on every run. Rebuild it, don't read it from git.
ml/eval/results/deadtime_visualization.html

# Pose keypoint caches from ml/eval/build_pose_cache.py (CF-198) — derived
# from the source videos, hundreds of MB, rebuildable. Same posture as the
# ball caches above.
ml/eval/pose_caches/
