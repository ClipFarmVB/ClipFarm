# Dependencies
node_modules/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
*.egg

# Build outputs
.next/
out/
build/

# Environment files
.env
.env.docker
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local scratch / manual tuning workspace (never commit)
ball-track/

# Ball-track dumps from ml/eval/diagnose_detection.py — derived from the R2
# ball-cache and regenerable, ~500KB each. The scores computed *from* them
# belong in results/*.jsonl; the raw track does not.
ml/eval/results/*_ball_track.json

# ML / data
*.pt
*.pth
*.onnx
*.mp4
data/
runs/

# Misc
.turbo/
.claude/
ml/eval/ball_caches/

# Roboflow dataset exports. Multi-hundred-MB archives that belong in the
# workspace they came from — GitHub rejects blobs over 100MB anyway.
*.zip
# Generated by ml/eval/visualize_deadtime.py — ~1MB of inline SVG that would
# re-churn its whole diff on every run. Rebuild it, don't read it from git.
ml/eval/results/deadtime_visualization.html

# Local-only compose override for social testing. Ignored and never committed,
# so it has no header to point at: it is where you set SOCIAL_ENABLED and
# NEXT_PUBLIC_SOCIAL_ENABLED to try the social stack against your own database
# without editing the tracked compose file.
docker-compose.override.yml
