.git
.gitignore
node_modules
web/node_modules
# Listed separately because a root-level pattern does not match nested paths —
# which is why `web/node_modules` is its own line above. `Dockerfile.web` now
# COPYs `packages/`, so without this a host-built install there would land in
# the image on top of what `npm ci` put in it.
packages/*/node_modules
api/.venv
.venv
web/.next
__pycache__
*.pyc
.DS_Store
# Never ship env files (secrets) into the build context — the image doesn't
# COPY them, but they'd otherwise be uploaded to the builder.
.env
.env.*
!.env.docker.example
