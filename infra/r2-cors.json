{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://clipfarm.ca",
          "https://www.clipfarm.ca",
          "http://localhost:3000",
          "http://127.0.0.1:3000"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
